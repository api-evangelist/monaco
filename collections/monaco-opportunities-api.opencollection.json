        {
          "info": {
            "name": "Update an Opportunity",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.monaco.com/v1/opportunities/:opportunity_id",
            "params": [
              {
                "name": "opportunity_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates an existing opportunity by its `opportunity_id`. Any `tags` list provided **replaces** the existing tags on the opportunity."
        },
        {
          "info": {
            "name": "Delete an Opportunity",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.monaco.com/v1/opportunities/:opportunity_id",
            "params": [
