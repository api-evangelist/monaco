                "name": "opportunity_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Deletes an opportunity by its `opportunity_id`. Returns 204 No Content on success. This is irreversible."
        },
        {
          "info": {
            "name": "Create an Opportunity",
            "type": "http"
          },
          "http": {
            "method": "POST",
